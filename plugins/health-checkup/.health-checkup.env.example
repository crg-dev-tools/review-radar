# Copy to the repository root as `.health-checkup.env` and edit the lines you
# need. Every key is optional: unset keys fall back to the defaults shown here.
# Sourced by the scripts as shell syntax, so quote values containing spaces.

# Where the checkup log is appended (repository-relative or absolute).
# HC_HEALTH_FILE=docs/health.md

# An open issue untouched for longer than this is counted as stale.
# HC_STALE_DAYS=90

# Limit every scan to these pathspecs (space separated). Empty = whole tracked tree.
# HC_SCAN_PATHS="src backend docs openspec"

# Drop paths matching this ERE from every scan — e.g. keep the scanner out of its
# own documentation, or out of vendored code that is tracked.
# HC_EXCLUDE_RE='^(docs/legacy/|third_party/)'

# Where specs live. #4 and #7 are skipped when none of these directories exist.
# HC_SPEC_DIRS="openspec/specs specs"

# Where e2e tests live. #4 is skipped when none of these exist.
# HC_E2E_DIRS="e2e tests/e2e"

# Coverage artifact for #3. Auto-detected when unset (lcov / istanbul
# coverage-summary.json / cobertura / jacoco).
# HC_COVERAGE_FILE=coverage/lcov.info

# Condition coverage (c2) is reported as skipped unless a value is supplied here,
# because none of the formats above emit it.
# HC_COVERAGE_C2=41%

# `md` or `md+html`. Only consulted for unattended runs (cron / CI): interactively
# the skill asks. The Markdown file is always written — it holds the state the
# next run reads — so the HTML is an additional view.
# HC_OUTPUT_FORMAT=md+html

# Where the HTML view goes. Defaults to HC_HEALTH_FILE with an .html extension.
# HC_HTML_FILE=docs/health.html
